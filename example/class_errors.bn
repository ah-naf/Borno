শ্রেণী কিছুএকটা {
  পদ্ধতি() {
    দেখাও "পদ্ধতি কল হয়েছে";
  }
}
ধরি বস্তু = কিছুএকটা();

// বস্তু.না থাকা_ফিল্ড; // প্রত্যাশিত ত্রুটি: Undefined property 'না থাকা_ফিল্ড'.
// বস্তু.না থাকা_পদ্ধতি(); // প্রত্যাশিত ত্রুটি: Undefined property 'না থাকা_পদ্ধতি'.

ধরি x = ১০;
// x.পদ্ধতি(); // প্রত্যাশিত ত্রুটি: Only instances have properties. (অথবা 'x is not an instance')

শ্রেণী ভুল < কিছুএকটা {
    init() {
        // দেখাও সুপার.ভুল_মেথড(); // প্রত্যাশিত ত্রুটি: Undefined method 'ভুল_মেথড' on superclass 'কিছুএকটা'.
    }
}
// ধরি y = ভুল(); // init কল হবে

// দেখাও এইটা.টেস্ট; // প্রত্যাশিত ত্রুটি: Cannot use 'এইটা' outside of a class method.
// দেখাও সুপার.টেস্ট; // প্রত্যাশিত ত্রুটি: Cannot use 'super' outside of a class method.

শ্রেণী সুপারনিল {
    init() {
        দেখাও "সুপারনিল";
    }
}
// শ্রেণী সাব < "ননক্লাস" { init() {} } // প্রত্যাশিত ত্রুটি: Superclass must be a class.
// ধরি z = সাব();
