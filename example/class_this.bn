শ্রেণী আয়তক্ষেত্র {
  init(দৈর্ঘ্য, প্রস্থ) {
    এইটা.দৈর্ঘ্য = দৈর্ঘ্য;
    এইটা.প্রস্থ = প্রস্থ;
  }

  ক্ষেত্রফল_গণনা() {
    ফেরত এইটা.দৈর্ঘ্য * এইটা.প্রস্থ;
  }

  তথ্য_দেখাও() {
    দেখাও "দৈর্ঘ্য: " + এইটা.দৈর্ঘ্য + ", প্রস্থ: " + এইটা.প্রস্থ;
    দেখাও "ক্ষেত্রফল: " + এইটা.ক্ষেত্রফল_গণনা(); // এইটা ব্যবহার করে অন্য মেথড কল
  }
}

ধরি আয়ত = আয়তক্ষেত্র(৫, ১০);
আয়ত.তথ্য_দেখাও();
