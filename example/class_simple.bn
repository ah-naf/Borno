শ্রেণী কেক {
  init(অবস্থা) {
    এইটা.অবস্থা = অবস্থা;
  }

  স্বাদ() {
    দেখাও এইটা.অবস্থা;
  }
}

শ্রেণী রুটি {
    init() {
        এইটা.নাম = "সাদা রুটি";
        দেখাও "রুটি তৈরি হচ্ছে!";
    }

    নাম_দেখাও() {
        দেখাও এইটা.নাম;
    }
}

ধরি আমারকেক = কেক("মিষ্টি");
আমারকেক.স্বাদ(); // প্রত্যাশিত আউটপুট: মিষ্টি

ধরি সাধারণরুটি = রুটি(); // প্রত্যাশিত আউটপুট: রুটি তৈরি হচ্ছে!
সাধারণরুটি.নাম_দেখাও(); // প্রত্যাশিত আউটপুট: সাদা রুটি
সাধারণরুটি.নাম = "লাল আটার রুটি";
দেখাও সাধারণরুটি.নাম; // প্রত্যাশিত আউটপুট: লাল আটার রুটি
