শ্রেণী পশু {
  init(নাম) {
    এইটা.নাম = নাম;
  }

  শব্দ_কর() {
    দেখাও এইটা.নাম + " একটি শব্দ করে।";
  }

  পরিচয়() {
    দেখাও "আমি একটি পশু, আমার নাম " + এইটা.নাম;
  }
}

শ্রেণী কুকুর < পশু {
  init(নাম, জাত) {
    সুপার.init(নাম); // সুপার কনস্ট্রাকটর কল (যদি init সুপার দিয়ে কল করা যায়)
                    // বর্তমান প্ল্যান অনুযায়ী সুপার শুধু মেথড কল করতে পারে, init নয়।
                    // তাই এইটা.নাম = নাম; সরাসরি ব্যবহার করতে হবে।
                    // অথবা init কে সাধারণ মেথড হিসেবে কল করতে হবে: সুপার.init(নাম);
                    // ধরে নিচ্ছি init একটি সাধারণ মেথড যা সুপার দিয়ে কল করা যায়।
    এইটা.জাত = জাত;
  }

  শব্দ_কর() { // মেথড ওভাররাইড
    দেখাও এইটা.নাম + " ঘেউ ঘেউ করে!";
  }

  পরিচয়_দাও() {
    সুপার.পরিচয়(); // সুপারক্লাসের মেথড কল
    দেখাও "আমি একটি " + এইটা.জাত + " কুকুর।";
  }
}

ধরি পোষা১ = কুকুর("টমি", "জার্মান শেফার্ড");
পোষা১.শব্দ_কর(); // প্রত্যাশিত আউটপুট: টমি ঘেউ ঘেউ করে!
পোষা১.পরিচয়_দাও();
// প্রত্যাশিত আউটপুট:
// আমি একটি পশু, আমার নাম টমি
// আমি একটি জার্মান শেফার্ড কুকুর।

// যদি সুপার.init(নাম) কাজ না করে, তাহলে init মেথডটিকে ম্যানুয়ালি কল করতে হবে বা নামটি সেট করতে হবে:
// শ্রেণী কুকুর < পশু {
//   init(নাম, জাত) {
//     এইটা.নাম = নাম; // ম্যানুয়ালি সেট
//     এইটা.জাত = জাত;
//   }
// ...
// }
